{
  "name": "@together-dog/ui",
  "version": "1.0.0",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src/globals.css"
  ],
  "license": "MIT",
  "private": false,
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts && cpx src/globals.css dist/",
    "dev": "storybook dev -p 6006",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "clean": "rimraf node_modules dist .turbo .storybook-cache"
  },
  "dependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "react-focus-lock": "^2.13.7"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^9.1.13",
    "@storybook/nextjs": "^9.1.13",
    "@storybook/react": "9.1.13",
    "@storybook/react-vite": "^9.1.13",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.0.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "cpx": "^1.5.0",
    "eslint": "^9.12.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.47",
    "storybook": "^9.1.13",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.6.3",
    "vite": "^6.0.11",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./globals.css": "./dist/globals.css",
    "./dist/globals.css": "./dist/globals.css"
  }
}
